<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">AnyCPU</PlatformTarget>
    <AssemblyName>BoneAI</AssemblyName>
    <RootNamespace>BoneAI</RootNamespace>
    <Version>3.0.0</Version>
    <BONELAB_DIR Condition="'$(BONELAB_DIR)' == ''">$(BONELAB_DIR_ENV)</BONELAB_DIR>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="src\Catalogs\bin\**\*.cs;src\Catalogs\obj\**\*.cs;src\Catalogs\artifacts\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader" HintPath="$(BONELAB_DIR)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(BONELAB_DIR)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="Il2CppSystem" HintPath="$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\Il2CppSystem.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Il2CppSLZ.Marrow" HintPath="$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\Il2CppSLZ.Marrow.dll" Private="false" />
    <Reference Include="Il2CppUniTask" HintPath="$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\Il2CppUniTask.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="UnityEngine.AndroidJNIModule" HintPath="$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\UnityEngine.AndroidJNIModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(BONELAB_DIR)\MelonLoader\Il2CppAssemblies\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(BONELAB_DIR)\MelonLoader\net6\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="BoneLib" HintPath="$(BONELAB_DIR)\Mods\BoneLib.dll" Private="false" />
  </ItemGroup>

  <Target Name="RequireBonelabDirectory" BeforeTargets="ResolveReferences" Condition="'$(BONELAB_DIR)' == ''">
    <Error Text="Set BONELAB_DIR (MSBuild property) or BONELAB_DIR_ENV to the BONELAB installation directory." />
  </Target>
</Project>
