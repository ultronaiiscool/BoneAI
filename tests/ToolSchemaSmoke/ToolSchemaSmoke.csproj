<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BONELAB_DIR Condition="'$(BONELAB_DIR)' == ''">$(BONELAB_DIR_ENV)</BONELAB_DIR>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Tools/ToolSchemaCatalog.cs" Link="ToolSchemaCatalog.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(BONELAB_DIR)' != ''">
    <Reference Include="Newtonsoft.Json" HintPath="$(BONELAB_DIR)/MelonLoader/net6/Newtonsoft.Json.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(BONELAB_DIR)' == ''">
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
